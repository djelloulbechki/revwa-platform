-- Profiles
CREATE POLICY "Users can view own profile"
  ON public.profiles FOR SELECT
  USING (auth.uid() = id OR public.is_platform_admin());

CREATE POLICY "Users can update own profile"
  ON public.profiles FOR UPDATE
  USING (auth.uid() = id);

-- Organizations
CREATE POLICY "Members can view their organizations"
  ON public.organizations FOR SELECT
  USING (
    public.is_platform_admin()
    OR id IN (SELECT public.get_user_org_ids())
  );

CREATE POLICY "Platform admin full access on organizations"
  ON public.organizations FOR ALL
  USING (public.is_platform_admin());

-- Organization Members
CREATE POLICY "Members can view org members"
  ON public.organization_members FOR SELECT
  USING (
    public.is_platform_admin()
    OR organization_id IN (SELECT public.get_user_org_ids())
  );

-- Vendor Profiles
CREATE POLICY "Vendors can manage own profile"
  ON public.vendor_profiles FOR ALL
  USING (
    public.is_platform_admin()
    OR organization_id IN (SELECT public.get_user_org_ids())
  );

CREATE POLICY "Authenticated users can view vendor profiles (for matching)"
  ON public.vendor_profiles FOR SELECT
  USING (auth.role() = 'authenticated');

-- Project Requests
CREATE POLICY "Buyers can manage their requests"
  ON public.project_requests FOR ALL
  USING (
    public.is_platform_admin()
    OR buyer_organization_id IN (SELECT public.get_user_org_ids())
  );

-- Scope Documents
CREATE POLICY "Access scope via request ownership"
  ON public.scope_documents FOR ALL
  USING (
    public.is_platform_admin()
    OR request_id IN (
      SELECT id FROM public.project_requests
      WHERE buyer_organization_id IN (SELECT public.get_user_org_ids())
    )
  );

-- RFQs
CREATE POLICY "Platform and related parties can view RFQs"
  ON public.rfqs FOR SELECT
  USING (
    public.is_platform_admin()
    OR request_id IN (
      SELECT id FROM public.project_requests
      WHERE buyer_organization_id IN (SELECT public.get_user_org_ids())
    )
    OR id IN (
      SELECT rfq_id FROM public.rfq_invitations
      WHERE vendor_organization_id IN (SELECT public.get_user_org_ids())
    )
  );

-- RFQ Invitations
CREATE POLICY "Vendors see their invitations"
  ON public.rfq_invitations FOR SELECT
  USING (
    public.is_platform_admin()
    OR vendor_organization_id IN (SELECT public.get_user_org_ids())
  );

-- Proposals
CREATE POLICY "Vendors manage their proposals"
  ON public.proposals FOR ALL
  USING (
    public.is_platform_admin()
    OR vendor_organization_id IN (SELECT public.get_user_org_ids())
  );

CREATE POLICY "Buyers can view shortlisted/accepted proposals"
  ON public.proposals FOR SELECT
  USING (
    public.is_platform_admin()
    OR (
      status IN ('shortlisted', 'accepted')
      AND rfq_id IN (
        SELECT r.id FROM public.rfqs r
        JOIN public.project_requests pr ON pr.id = r.request_id
        WHERE pr.buyer_organization_id IN (SELECT public.get_user_org_ids())
      )
    )
  );

-- Shortlists
CREATE POLICY "Buyers and platform can manage shortlists"
  ON public.shortlists FOR ALL
  USING (
    public.is_platform_admin()
    OR request_id IN (
      SELECT id FROM public.project_requests
      WHERE buyer_organization_id IN (SELECT public.get_user_org_ids())
    )
  );

-- Deals
CREATE POLICY "Parties can view their deals"
  ON public.deals FOR SELECT
  USING (
    public.is_platform_admin()
    OR buyer_organization_id IN (SELECT public.get_user_org_ids())
    OR vendor_organization_id IN (SELECT public.get_user_org_ids())
  );

-- Commissions
CREATE POLICY "Vendors and platform can view commissions"
  ON public.commissions FOR SELECT
  USING (
    public.is_platform_admin()
    OR vendor_organization_id IN (SELECT public.get_user_org_ids())
  );

-- Quote Audits
CREATE POLICY "Buyers manage their audits"
  ON public.quote_audits FOR ALL
  USING (
    public.is_platform_admin()
    OR buyer_organization_id IN (SELECT public.get_user_org_ids())
    OR created_by = auth.uid()
  );

-- Notifications
CREATE POLICY "Users manage own notifications"
  ON public.notifications FOR ALL
  USING (user_id = auth.uid() OR public.is_platform_admin());

-- Categories (public read)
CREATE POLICY "Anyone can read categories"
  ON public.categories FOR SELECT
  USING (true);

CREATE POLICY "Platform admin manages categories"
  ON public.categories FOR ALL
  USING (public.is_platform_admin());

