CREATE UNIQUE INDEX idx_rfqs_anonymous_code ON public.rfqs(anonymous_code);
CREATE INDEX idx_rfqs_status ON public.rfqs(status);

CREATE TABLE public.rfq_invitations (
  id UUID PRIMARY KEY DEFAULT public.generate_uuid_v7(),
  rfq_id UUID NOT NULL REFERENCES public.rfqs(id) ON DELETE CASCADE,
  vendor_organization_id UUID NOT NULL REFERENCES public.organizations(id) ON DELETE CASCADE,

  invited_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  viewed_at TIMESTAMPTZ,
  status invitation_status NOT NULL DEFAULT 'invited',

  UNIQUE (rfq_id, vendor_organization_id)
);

CREATE INDEX idx_rfq_invitations_vendor ON public.rfq_invitations(vendor_organization_id);
CREATE INDEX idx_rfq_invitations_rfq ON public.rfq_invitations(rfq_id);
CREATE INDEX idx_rfq_invitations_status ON public.rfq_invitations(status);

-- =====================================================
-- 7. PROPOSALS (Blind Bids)
-- =====================================================
CREATE TABLE public.proposals (
  id UUID PRIMARY KEY DEFAULT public.generate_uuid_v7(),
  rfq_id UUID NOT NULL REFERENCES public.rfqs(id) ON DELETE CASCADE,
  vendor_organization_id UUID NOT NULL REFERENCES public.organizations(id) ON DELETE CASCADE,
  submitted_by UUID REFERENCES public.profiles(id) ON DELETE SET NULL,

  status proposal_status NOT NULL DEFAULT 'draft',

  total_price NUMERIC(14,2) NOT NULL CHECK (total_price >= 0),
  currency CHAR(3) DEFAULT 'USD',
  pricing_model TEXT,
  payment_terms TEXT,
  estimated_duration_days INTEGER,

  technical_approach TEXT,
  team_composition JSONB DEFAULT '[]'::jsonb,
  timeline_milestones JSONB DEFAULT '[]'::jsonb,
  assumptions TEXT[],
  exclusions TEXT[],

  proposal_document_url TEXT,
  additional_files JSONB DEFAULT '[]'::jsonb,

  platform_score NUMERIC(5,2),
  evaluation_notes TEXT,

  submitted_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),

  UNIQUE (rfq_id, vendor_organization_id)
);

CREATE INDEX idx_proposals_rfq ON public.proposals(rfq_id);
CREATE INDEX idx_proposals_vendor ON public.proposals(vendor_organization_id);
CREATE INDEX idx_proposals_status ON public.proposals(status);
CREATE INDEX idx_proposals_submitted ON public.proposals(submitted_at DESC) WHERE status = 'submitted';

-- =====================================================
-- 8. SHORTLISTS
-- =====================================================
CREATE TABLE public.shortlists (
  id UUID PRIMARY KEY DEFAULT public.generate_uuid_v7(),
  request_id UUID NOT NULL REFERENCES public.project_requests(id) ON DELETE CASCADE,
  proposal_id UUID NOT NULL REFERENCES public.proposals(id) ON DELETE CASCADE,

  rank INTEGER CHECK (rank BETWEEN 1 AND 10),
  platform_recommendation_reason TEXT,
  buyer_notes TEXT,

  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  UNIQUE (request_id, proposal_id)
);

CREATE INDEX idx_shortlists_request ON public.shortlists(request_id);

-- =====================================================
-- 9. DEALS & COMMISSIONS
-- =====================================================
CREATE TABLE public.deals (
  id UUID PRIMARY KEY DEFAULT public.generate_uuid_v7(),
  request_id UUID NOT NULL REFERENCES public.project_requests(id) ON DELETE CASCADE,
  proposal_id UUID NOT NULL REFERENCES public.proposals(id) ON DELETE CASCADE,
  buyer_organization_id UUID NOT NULL REFERENCES public.organizations(id) ON DELETE CASCADE,
  vendor_organization_id UUID NOT NULL REFERENCES public.organizations(id) ON DELETE CASCADE,

  status deal_status NOT NULL DEFAULT 'pending_signature',
  final_amount NUMERIC(14,2) NOT NULL CHECK (final_amount >= 0),
  currency CHAR(3) DEFAULT 'USD',

