-- =====================================================
-- 0. NATIVE UUIDv7 GENERATOR (Time-ordered - Recommended)
-- =====================================================
CREATE OR REPLACE FUNCTION public.generate_uuid_v7()
RETURNS UUID
LANGUAGE plpgsql
VOLATILE
PARALLEL SAFE
AS $$
DECLARE
  unix_ts_ms BYTEA;
  uuid_bytes BYTEA;
BEGIN
  unix_ts_ms := substring(int8send(floor(extract(epoch from clock_timestamp()) * 1000)::bigint) from 3);
  uuid_bytes := unix_ts_ms || gen_random_bytes(10);
  -- set version to 7
  uuid_bytes := set_byte(uuid_bytes, 6, (get_byte(uuid_bytes, 6) & 15) | 112);
  -- set variant to RFC 4122
  uuid_bytes := set_byte(uuid_bytes, 8, (get_byte(uuid_bytes, 8) & 63) | 128);
  RETURN encode(uuid_bytes, 'hex')::uuid;
END;
$$;

-- =====================================================
-- 1. ENUMS
-- =====================================================
CREATE TYPE user_role AS ENUM (
  'platform_admin',
  'buyer_admin',
  'buyer_member',
  'vendor_admin',
  'vendor_member',
  'viewer'
);

CREATE TYPE org_type AS ENUM ('buyer', 'vendor', 'both');

CREATE TYPE request_status AS ENUM (
  'draft',
  'submitted',
  'under_review',
  'scoping',
  'rfq_sent',
  'proposals_received',
  'shortlisted',
  'negotiation',
  'won',
  'lost',
  'cancelled',
  'archived'
);

CREATE TYPE proposal_status AS ENUM (
  'draft',
  'submitted',
  'under_review',
  'shortlisted',
  'rejected',
  'accepted',
  'withdrawn'
);

CREATE TYPE deal_status AS ENUM (
  'pending_signature',
  'active',
  'completed',
  'cancelled',
  'disputed'
);

CREATE TYPE commission_status AS ENUM (
  'pending',
  'invoiced',
  'paid',
  'waived',
  'disputed'
);

CREATE TYPE quote_audit_status AS ENUM (
  'submitted',
  'in_review',
  'completed',
  'archived'
);

CREATE TYPE company_size AS ENUM (
  '1-10',
  '11-50',
  '51-200',
  '201-500',
  '501-1000',
  '1001-5000',
  '5000+'
);

CREATE TYPE rfq_status AS ENUM (
  'open',
  'closed',
  'awarded',
  'cancelled'
);

CREATE TYPE invitation_status AS ENUM (
  'invited',
  'viewed',
  'declined',
  'submitted'
);

-- =====================================================
-- 2. CORE TABLES
-- =====================================================

-- Profiles (extends auth.users)
CREATE TABLE public.profiles (
  id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  email TEXT,
  full_name TEXT,
  phone TEXT,
  avatar_url TEXT,
  role user_role NOT NULL DEFAULT 'viewer',
  is_active BOOLEAN NOT NULL DEFAULT true,
  last_seen_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Organizations (Buyers & Vendors)
CREATE TABLE public.organizations (
  id UUID PRIMARY KEY DEFAULT public.generate_uuid_v7(),
  name TEXT NOT NULL,
  legal_name TEXT,
  type org_type NOT NULL,
  country_code CHAR(2),
  city TEXT,
  website TEXT,
  logo_url TEXT,
  description TEXT,
  company_size company_size,
  annual_revenue_range TEXT,
  tax_id TEXT,
  is_verified BOOLEAN NOT NULL DEFAULT false,
  is_active BOOLEAN NOT NULL DEFAULT true,
  metadata JSONB DEFAULT '{}'::jsonb,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  deleted_at TIMESTAMPTZ
);

CREATE INDEX idx_organizations_type ON public.organizations(type);
CREATE INDEX idx_organizations_active ON public.organizations(is_active) WHERE deleted_at IS NULL;
CREATE INDEX idx_organizations_country ON public.organizations(country_code);

-- Organization Members
CREATE TABLE public.organization_members (
  id UUID PRIMARY KEY DEFAULT public.generate_uuid_v7(),
  organization_id UUID NOT NULL REFERENCES public.organizations(id) ON DELETE CASCADE,
  user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
  role user_role NOT NULL DEFAULT 'buyer_member',
  is_primary BOOLEAN NOT NULL DEFAULT false,
  joined_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  UNIQUE (organization_id, user_id)
);

CREATE INDEX idx_org_members_user ON public.organization_members(user_id);
CREATE INDEX idx_org_members_org ON public.organization_members(organization_id);

-- =====================================================
-- 3. VENDOR PROFILES & MATCHING METADATA
-- =====================================================
CREATE TABLE public.vendor_profiles (
  id UUID PRIMARY KEY DEFAULT public.generate_uuid_v7(),
  organization_id UUID NOT NULL UNIQUE REFERENCES public.organizations(id) ON DELETE CASCADE,

  -- Technical Specializations
  specialties TEXT[] DEFAULT '{}',
  technologies TEXT[] DEFAULT '{}',
  industries_served TEXT[] DEFAULT '{}',
  geo_coverage TEXT[] DEFAULT '{}',
  team_size INTEGER,
  years_in_business INTEGER,

  -- Capacity & Financials
  min_project_budget NUMERIC(14,2),
  max_concurrent_projects INTEGER,
  average_project_duration_days INTEGER,

  -- Validation & Credibility
  portfolio_urls TEXT[] DEFAULT '{}',
  case_studies JSONB DEFAULT '[]'::jsonb,
  certifications TEXT[] DEFAULT '{}',
  preferred_engagement_models TEXT[] DEFAULT '{}',

  -- Scoring & Metrics
  platform_score NUMERIC(5,2) DEFAULT 0,
  success_rate NUMERIC(5,2),
  average_rating NUMERIC(3,2),
  total_deals_closed INTEGER DEFAULT 0,

  -- Subscription & Monetization
  is_certified_partner BOOLEAN NOT NULL DEFAULT false,
  subscription_plan TEXT DEFAULT 'free',
  subscription_starts_at TIMESTAMPTZ,
  subscription_ends_at TIMESTAMPTZ,

  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- GIN Indexes for high-performance matching
CREATE INDEX idx_vendor_specialties_gin ON public.vendor_profiles USING GIN (specialties);
CREATE INDEX idx_vendor_technologies_gin ON public.vendor_profiles USING GIN (technologies);
CREATE INDEX idx_vendor_industries_gin ON public.vendor_profiles USING GIN (industries_served);
CREATE INDEX idx_vendor_geo_gin ON public.vendor_profiles USING GIN (geo_coverage);

-- =====================================================
-- 4. PROJECT REQUESTS / INTAKE
-- =====================================================
CREATE TABLE public.project_requests (
  id UUID PRIMARY KEY DEFAULT public.generate_uuid_v7(),
  buyer_organization_id UUID NOT NULL REFERENCES public.organizations(id) ON DELETE CASCADE,
  created_by UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,

  title TEXT,
  description_text TEXT,
  voice_recording_url TEXT,
  voice_transcript TEXT,

  company_size company_size,
  timeline TEXT,
  budget_min NUMERIC(14,2),
  budget_max NUMERIC(14,2),
  currency CHAR(3) DEFAULT 'USD',

  current_systems TEXT[],
  main_pain_points TEXT[],
  success_metrics TEXT[],

  status request_status NOT NULL DEFAULT 'draft',
  priority INTEGER DEFAULT 3 CHECK (priority BETWEEN 1 AND 5),

  assigned_to UUID REFERENCES public.profiles(id) ON DELETE SET NULL,
  internal_notes TEXT,
  scoring_data JSONB DEFAULT '{}'::jsonb,

  submitted_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  deleted_at TIMESTAMPTZ,

  CONSTRAINT check_budget_range CHECK (
    budget_min IS NULL OR budget_max IS NULL OR budget_min <= budget_max
  )
);

CREATE INDEX idx_project_requests_buyer ON public.project_requests(buyer_organization_id);
CREATE INDEX idx_project_requests_status ON public.project_requests(status);
CREATE INDEX idx_project_requests_created ON public.project_requests(created_at DESC);
CREATE INDEX idx_project_requests_assigned ON public.project_requests(assigned_to) WHERE assigned_to IS NOT NULL;
CREATE INDEX idx_project_requests_not_deleted ON public.project_requests(id) WHERE deleted_at IS NULL;

-- =====================================================
-- 5. SCOPE DOCUMENTS
-- =====================================================
CREATE TABLE public.scope_documents (
  id UUID PRIMARY KEY DEFAULT public.generate_uuid_v7(),
  request_id UUID NOT NULL UNIQUE REFERENCES public.project_requests(id) ON DELETE CASCADE,

  version INTEGER NOT NULL DEFAULT 1,
  title TEXT NOT NULL,

  objectives TEXT[],
  functional_requirements JSONB DEFAULT '[]'::jsonb,
  non_functional_requirements JSONB DEFAULT '[]'::jsonb,
  technical_constraints JSONB DEFAULT '{}'::jsonb,
  integrations_required TEXT[],
  out_of_scope TEXT[],
  assumptions TEXT[],
  acceptance_criteria TEXT[],

  estimated_budget_range NUMRANGE,
  preferred_timeline_days INTEGER,

  full_document_url TEXT,
  raw_content JSONB,

  created_by UUID REFERENCES public.profiles(id) ON DELETE SET NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- =====================================================
-- 6. RFQ SYSTEM (Anonymous)
-- =====================================================
CREATE TABLE public.rfqs (
  id UUID PRIMARY KEY DEFAULT public.generate_uuid_v7(),
  request_id UUID NOT NULL REFERENCES public.project_requests(id) ON DELETE CASCADE,
  scope_document_id UUID NOT NULL REFERENCES public.scope_documents(id) ON DELETE CASCADE,

  title TEXT NOT NULL,
  anonymous_code TEXT NOT NULL,
  status rfq_status NOT NULL DEFAULT 'open',

  deadline_at TIMESTAMPTZ,
  max_proposals INTEGER DEFAULT 8,

  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
