CREATE INDEX idx_deals_buyer ON public.deals(buyer_organization_id);
CREATE INDEX idx_deals_vendor ON public.deals(vendor_organization_id);
CREATE INDEX idx_deals_status ON public.deals(status);

CREATE TABLE public.commissions (
  id UUID PRIMARY KEY DEFAULT public.generate_uuid_v7(),
  deal_id UUID NOT NULL REFERENCES public.deals(id) ON DELETE CASCADE,
  vendor_organization_id UUID NOT NULL REFERENCES public.organizations(id) ON DELETE CASCADE,

  deal_amount NUMERIC(14,2) NOT NULL,
  commission_rate NUMERIC(5,4) NOT NULL CHECK (commission_rate >= 0 AND commission_rate <= 1),
  commission_amount NUMERIC(14,2) NOT NULL,

  status commission_status NOT NULL DEFAULT 'pending',
  invoice_url TEXT,
  paid_at TIMESTAMPTZ,

  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_commissions_vendor ON public.commissions(vendor_organization_id);
CREATE INDEX idx_commissions_status ON public.commissions(status);

-- =====================================================
